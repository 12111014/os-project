{
  "name": "agentfs",
  "target": "fuse",
  "language": "c",
  "backend": "libfuse3",
  "storage": {
    "type": "memory",
    "block_size": 4096,
    "image_size_mb": 1024
  },
  "features": {
    "directories": true,
    "symlink": false,
    "hardlink": false,
    "permissions": "basic",
    "journaling": false,
    "xattrs": false
  },
  "operations": [
    "getattr",
    "readdir",
    "mkdir",
    "rmdir",
    "create",
    "open",
    "read",
    "write",
    "unlink",
    "rename",
    "truncate",
    "chmod",
    "fsync"
  ],
  "validation": {
    "posix_smoke": true,
    "pytest": true,
    "fio": false,
    "filebench": false,
    "xfstests": false
  }
}